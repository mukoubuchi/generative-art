# macOS
.DS_Store
# Node.js
node_modules/
# Generated output; nothing rendered is committed
exports/*
!exports/.gitkeep
# The Pages site, built from the manifest at deploy time; the p5 library is copied into it
site/
# X credentials belong outside the repository, and the authorization scripts refuse paths inside it;
# these names stay ignored as a safeguard
p5js/x-access-token
p5js/x-refresh-token
